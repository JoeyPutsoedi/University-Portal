@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/styles/styles.css" />
<link rel="stylesheet" href="fontawesome/css/all.css"/>



    <div class="home-container">
        <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/cut-bkg-one.jpg" class="d-block w-100" alt="This is image 1">
                    <div class="carousel-caption d-none d-md-block">

                        <h5>Thinking Beyond!</h5>
                        <p>
                            Here we help prospective students turn dreams into reality and encourage them to dream even<br />
                            bigger because we believe with hard work and dedication no dream is too far to reach.
                        </p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/cut-bkg-two.jpg" class="d-block w-100" alt="this is image 3">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Celebrating 20 Years!</h5>
                        <p>
                            We've been previlliged with having to produce some of the sharperst minds and athletes for 20 years and we are<br />
                            beyond excited to see what the years to come have in store for .
                        </p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/cut-bkg-three.jpg" class="d-block w-100" alt="This is image 2">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Enroll Now</h5>
                        <p>Applications for 2025 are open. Enroll now and become a member of the CUT family <br /> what are you waiting for? </p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    <!----------------------------------------Stats----------------------------------------------------->

   <div class="stats-container">
       <div class="stats">
           <p class="figure">160K+</p>
           <p class="figure-info">Over 160000 students enrolled <br/> across both our campuses</p>
       </div>
       <div class="stats">
            <p class="figure">60K+</p>
            <p class="figure-info">Over 60k students enrolled per year <br />educating more prospects with<br/> every year</p>
       </div>
       <div class="stats">
            <p class="figure">80%</p>
            <p class="figure-info">Over 80% of our students graduate<br />  within record time</p>
       </div>
       <div class="stats">
            <p class="figure">20Y+</p>
            <p class="figure-info">Over 20 years of empowering and <br />sharpening young minds</p>
       </div>
   </div>
        <!----------------------------------------Student life----------------------------------------------------->
  <div class="articles-section">
      <h1>Featured articles & blogs</h1>
      <div class="article-wrapper">

      <div class="article-cont">
          <img src="~/images/adone.JPG" />
          <div class="article-text">
              <p>Read about the sports we have to offer <br />on our campuses. </p>
              <div>    <a asp-controller="Student" asp-action="Sports">Read here</a></div>
          </div>
      </div>
      <div class="article-cont">
                <img src="~/images/adtwo.JPG" />
                <div class="article-text">
                    <p>Home for those with ideas the IGym provides resources and knowledge for students with innovative minds.</p>
                    <div>    <a asp-controller="Student" asp-action="IGym">Read here</a></div>
                </div>
     </div>
     <div class="article-cont">
                <img src="~/images/adthree.JPG" />
                <div class="article-text">
                    <p>Our state of the art library provides students<br/>with books, computers and other resources<br/>to assist them as they learn. </p>
                    <div>    <a asp-controller="Student" asp-action="Library">Read here</a></div>
                </div>
     </div>
     <div class="article-cont">
                <img src="~/images/adfour.JPG" />
                <div class="article-text">
                    <p>At CUT we believe that a healthy mind should be accompanied by a healthy body thus the outdoor gym available and free to all our students.</p>
                    <div>    <a asp-controller="Student" asp-action="Wellness">Read here</a></div>
                </div>
    </div>
      </div>
  </div>
    <!----------------------------------------About----------------------------------------------------->
    <div class="about-container"> 
        <p class="about-bttn">ABOUT</p>
        <p class="text-para">
                 CUT offers high quality education and facilities. we're privilliged to have sharpened some of the most prestigous minds<br />
                our institution offers a variety of courses for students to choose from. we also offer facilities and resources for <br />
                extra curricular activities the likes of soccer, rugby, hockey and many more. we believe that a sharp mind needs a fit body to accompany it<br />
                which is why we encourage our students to be involved in atleast one.<br /><br />
                Our institution also has facilities that promote & stimulate intellectual growth, our library which has high quality resources and the i-gym <br />
            which caters to our students with dreams and big ideas.<br /><br /></p>

           <div class="excellence">
               <img src="~/images/Graduate.jpg" class="image-section" />
               <div class="text-section">
                   <div class="points">

                    <h1>ACADEMIC SUCCESS</h1>
                    <p>Our graduates have gone onto accomplish remarkable <br /> things even today they still find success across <br /> various fields.</p>
                   </div>
                <div class="points">

                    <h1>STUDENT ORGANIZATIONS</h1>
                    <p>There is a number of student organizations that ensure <br /> that student needs are met they work hand in hand <br />with management to ensure every student <br/>has a pleasant university experience.</p>
                </div>
                <div class="points">

                    <h1>VIBRANT COMMUNITY</h1>
                    <p>We take pride in the diversity of our students <br /> we do our best to represent every culture  <br /> with our campus events and resources so <br /> that every student feels at home.</p>
                </div>
               </div>
           </div>
    </div>
