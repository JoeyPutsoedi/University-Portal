@model ASPNETCore_DB.Models.Student

@{
    ViewData["Title"] = "Create";
}
<link rel="stylesheet" href="~/css/styles.css" />
<link rel="stylesheet" href="~/css/create.css" />
<link rel="stylesheet" href="~/styles/responsiveness.css" />
<link rel="stylesheet" href="~/css/utils.css" />

<div  class="enroll-container">

        <form asp-action="Create" enctype="multipart/form-data">
    <h1>Create</h1>
    <p class="student">Student</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-floating">
            <p class="label">Student Number</p>
                <input asp-for="StudentNumber" class=""  readonly/>
                <span asp-validation-for="StudentNumber" class="text-danger"></span>
            </div>
        <div class="form-floating">
            <p class="label">First Name</p>
                <input asp-for="FirstName" class=""  />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        <div class="form-floating">
            <p class="label">Surname</p>
                <input asp-for="Surname" class=""  />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>
        <div class="form-floating">
            <p class="label">Enrollment Date</p>
                <input asp-for="EnrollmentDate" class=""  />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
            @* Displaying image*@

       
                <div class="image-placeholder">
                
                    <img src="~/images/DefaultPic.png" width="100" style="border-radius:5px; border:1px solid white" />
                   
                </div>
       

            @* Uploading Image*@
    
                <div class="image-input">
                    <input type="file" name="files" id="uploadBox" multiple class="form-control" />
                </div>
        

            <div class="button-wrapper" id="btn">
                <button type="submit" value="Create" class="" >Create</button>
            </div>
            @* <div class="back">
                <p><a href="\Views\Student\Details.cshtml" onclick="student()">Back to list</a></p>
            </div> *@
        </form>
   
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
