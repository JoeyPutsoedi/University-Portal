<link rel="stylesheet" href="~/css/styles.css" />
<link rel="stylesheet" href="~/css/contact.css" />
<link rel="stylesheet" href="~/styles/responsiveness.css" />
<link rel="stylesheet" href="fontawesome/css/all.css" />
<body class="contact-body">



    <!--------COLUMNS---------->
    <div class="contact-container">
        <!--------LEFT COLUMN---------->
        <form asp-action="Contact" class="contact-left-column">
          
                <h2 class="contact-us">Contact Us</h2>
                <hr class="line">
            <div class="form-floating">
                <p class="label">Name</p>
              
                <input type="text" name="name"  class="" required>
            </div>

            <div class="form-floating">
                <p class="label">Email</p>
                <input type="email" name="email"  class="" required>
            </div>

            <div class="form-floating">
                <p class="label">Your message</p>
                <textarea name="emailMessage"  class="" required></textarea>
            </div>
               


            <div class="button-wrapper">

            <button type="submit">submit<i class="fa-solid fa-right-long 2x"></i></button>
            </div>
        </form>

    </div>

</body>


