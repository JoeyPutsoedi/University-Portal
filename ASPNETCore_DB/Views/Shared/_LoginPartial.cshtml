@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="nav-util">
    @if (SignInManager.IsSignedIn(User))
    {
         <li class="manage-text">
            <a id="manage" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User)!</a>
         </li>

   
        <li class="util-bttn">
            <a id="logoutForm" class="" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">Logout</a>
        </li>
    }
    else
    {
        <li class="util-bttn">
            <a class="" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="util-bttn">
            <a class="" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

