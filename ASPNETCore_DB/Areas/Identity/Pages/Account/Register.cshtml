@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>
<link rel="stylesheet" href="~/css/styles.css" />
<link rel="stylesheet" href="~/css/utils.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/styles//responsiveness.css" />
<link rel="stylesheet" href="fontawesome/css/all.css" />


    <div class="register-container">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Create a new account.</h2>

            <hr />
            <div asp-validation-summary="ModelOnly" class=""></div>
        <div class="form-floating">
            <p class="label">Email</p>
                <input  asp-for="Input.Email" class="" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="validate-text"></span>
            </div>
        <div class="form-floating">
                <p class="label">Password</p>
                <input  asp-for="Input.Password" class="" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="validate-text"></span>
            </div>
            <div class="form-floating">
               <p class="label">Confirm Password</p>
                <input  asp-for="Input.ConfirmPassword" class="" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="validate-text"></span>
            </div>
            <div class="button-wrapper">
            <button type="submit" class="">Register</button>
            </div>
        </form>
    </div>

       
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
