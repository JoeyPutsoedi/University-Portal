@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header>
<link rel="stylesheet" href="~/css/utils.css" />
    <link rel="stylesheet" href="~/styles//responsiveness.css" />
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div style="width: 100vw;height:80vh; ">
            <form style="margin-top: 3em; display:flex; justify-content: center;" class="logout-wrapper" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button style="background-color: dodgerblue; color: white; border: none; height: 2.8em; border-radius: .5em; width: 15em;"type="submit" >Click here to Logout</button>
            </form>
</div>
        }
        else
        {
            <p>You have successfully logged out of the application.</p>
        }
    }
</header>
